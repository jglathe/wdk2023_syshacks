#!/bin/sh

set -e

PREREQ=""

prereqs()
{
	echo "$PREREQ"
}

case \\$1 in
# get pre-requisites
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

mv /lib/firmware/updates/qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn.disabled /lib/firmware/updates/qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn

# Define a list of firmware files to be included

FIRMWARE_FILES="\
updates/qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/adsp_dtbs.elf \
updates/qcom/x1e80100/Thundercomm/DEVKIT/adspr.jsn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/adsps.jsn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/adspua.jsn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/battmgr.jsn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/qccdsp8380.mbn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/cdsp_dtbs.elf \
updates/qcom/x1e80100/Thundercomm/DEVKIT/cdspr.jsn \
updates/qcom/x1e80100/Thundercomm/DEVKIT/qcdxkmsuc8380.mbn \
updates/qcom/gen70500_gmu.bin.zst \
updates/qcom/gen70500_sqe.fw.zst"

# Copy each firmware file to initramfs
for file in $FIRMWARE_FILES; do
    dir=$(dirname "$file")
    mkdir -p "${DESTDIR}/lib/firmware/${dir}"
    cp "/lib/firmware/${file}" "${DESTDIR}/lib/firmware/${dir}/"
done

mv /lib/firmware/updates/qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn /lib/firmware/updates/qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn.disabled

